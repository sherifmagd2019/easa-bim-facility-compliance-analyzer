<Window x:Class="EasaCompliance.UI.Views.RuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="EASA Part-145 Rule Library &amp; Custom Rule Editor — Revit 2027"
        Height="800" Width="1240" MinWidth="1050" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Ribbon -->
        <Border Grid.Row="0" Background="#020617" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Vertical">
                <!-- Developer Ribbon -->
                <Border Background="#090D16" Padding="20,6" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="Developer: " Foreground="#94A3B8" FontSize="11" FontWeight="Medium"/>
                            <TextBlock Text="Developer Eng. Sherif Ahmad Magdaldin" Foreground="#F59E0B" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="Autodesk Revit 2027 | EASA Part-145 Rule Customization Engine" DockPanel.Dock="Right" Foreground="#64748B" FontSize="11"/>
                    </DockPanel>
                </Border>

                <!-- Title & Actions -->
                <Border Padding="20,12">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                            <TextBlock Text="EASA PART-145 RULE LIBRARY &amp; CUSTOM RULE BUILDER" 
                                       Foreground="#FFFFFF" FontSize="17" FontWeight="Bold"/>
                            <TextBlock Text="Configure rule evaluation logic, adjust engineering thresholds, or register new facility checks" 
                                       Foreground="#94A3B8" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Button Content="+ Add New Rule" Click="BtnAddNewRule_Click"
                                    Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold"
                                    Padding="14,7" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
                            <Button Content="Reset Built-In Defaults" Click="BtnResetDefaults_Click"
                                    Background="#334155" Foreground="#CBD5E1" FontWeight="SemiBold"
                                    Padding="12,7" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Main Workspace: Split Grid -->
        <Grid Grid.Row="1" Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Rules List & Filter -->
            <Border Grid.Column="0" Background="#090D16" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Margin="0,0,12,0" Padding="12">
                <DockPanel LastChildFill="True">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Registered Rules Catalog" Foreground="#38BDF8" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="TxtRuleCountBadge" Text="6 Rules" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Right"/>
                    </DockPanel>

                    <!-- Rules DataGrid -->
                    <DataGrid x:Name="DgRules" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionChanged="DgRules_SelectionChanged"
                              Background="Transparent" RowBackground="#090D16" AlternatingRowBackground="#0F172A"
                              Foreground="#E2E8F0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1E293B"
                              HeadersVisibility="Column" RowHeight="34" BorderThickness="0" Margin="0,0,0,10">
                        <DataGrid.Resources>
                            <Style TargetType="{x:Type DataGridColumnHeader}">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="8,6"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Rule ID" Binding="{Binding RuleId}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#F8FAFC"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Clause" Binding="{Binding ApplicableClause}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#38BDF8"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Rule Name" Binding="{Binding Name}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsEnabled}" Width="55"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button DockPanel.Dock="Bottom" Content="Delete Selected Rule" Click="BtnDeleteRule_Click"
                            Background="#7F1D1D" Foreground="#FCA5A5" FontWeight="SemiBold"
                            Padding="10,6" BorderThickness="0" HorizontalAlignment="Left" Cursor="Hand"/>
                </DockPanel>
            </Border>

            <!-- Right: Rule Editor Form -->
            <Border Grid.Column="1" Background="#090D16" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <DockPanel LastChildFill="False" Margin="0,0,0,14">
                            <TextBlock x:Name="TxtEditorModeTitle" Text="EDITING RULE: RULE-145-FAC-01" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" DockPanel.Dock="Left"/>
                            <TextBlock x:Name="TxtEditorStatus" Text="Changes auto-apply upon save" FontSize="11" Foreground="#94A3B8" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Rule ID & Rule Title -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Rule Identifier (Unique ID):" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtRuleId" Padding="6,4" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#334155" FontFamily="Consolas"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Rule Name / Title:" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtRuleName" Padding="6,4" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#334155"/>
                            </StackPanel>
                        </Grid>

                        <!-- Applicable Clause & Regulatory Reference -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Applicable EASA Clause:" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtApplicableClause" Text="145.A.25(d)" Padding="6,4" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#334155"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Regulatory Reference:" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtRegulatoryReference" Text="145.A.25(d)" Padding="6,4" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#334155"/>
                            </StackPanel>
                        </Grid>

                        <!-- Classification, Evaluation Type, Severity -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Legal Classification:" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <ComboBox x:Name="CmbClassification" Background="#1E293B" Foreground="#000000" Padding="4">
                                    <ComboBoxItem Content="Regulatory" IsSelected="True"/>
                                    <ComboBoxItem Content="AMC_GM"/>
                                    <ComboBoxItem Content="ProjectAssumption"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Evaluation Type:" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <ComboBox x:Name="CmbEvaluationType" Background="#1E293B" Foreground="#000000" Padding="4">
                                    <ComboBoxItem Content="RoomExistenceCheck" IsSelected="True"/>
                                    <ComboBoxItem Content="DoorClearanceCheck"/>
                                    <ComboBoxItem Content="EquipmentAssetPresenceCheck"/>
                                    <ComboBoxItem Content="SpatialDistanceCheck"/>
                                    <ComboBoxItem Content="SecurityAccessControlCheck"/>
                                    <ComboBoxItem Content="ParameterCompletenessCheck"/>
                                    <ComboBoxItem Content="DocumentaryReviewCheck"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Default Severity Level:" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <ComboBox x:Name="CmbSeverity" Background="#1E293B" Foreground="#000000" Padding="4">
                                    <ComboBoxItem Content="Critical"/>
                                    <ComboBoxItem Content="High" IsSelected="True"/>
                                    <ComboBoxItem Content="Medium"/>
                                    <ComboBoxItem Content="Low"/>
                                    <ComboBoxItem Content="Informational"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Checkboxes: Enabled, RequiresHumanReview -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <CheckBox x:Name="ChkIsEnabled" Content="Rule Is Enabled &amp; Active" IsChecked="True" Foreground="#FFFFFF" Margin="0,0,24,0"/>
                            <CheckBox x:Name="ChkRequiresHumanReview" Content="Requires Human Reviewer Confirmation" IsChecked="True" Foreground="#CBD5E1"/>
                        </StackPanel>

                        <!-- Configurable Parameters (Key & Value) -->
                        <Border Background="#020617" BorderBrush="#1E293B" BorderThickness="1" Padding="12" CornerRadius="4" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Configurable Engine Parameter (Key / Threshold Value):" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Parameter Key (e.g., RoomKeyword, MaxDistanceM):" Foreground="#94A3B8" FontSize="10" Margin="0,0,0,2"/>
                                        <TextBox x:Name="TxtParamKey" Text="RoomKeyword" Padding="6,3" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#334155" FontFamily="Consolas"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Parameter Value (e.g., Quarantine, 15.0, 2950):" Foreground="#94A3B8" FontSize="10" Margin="0,0,0,2"/>
                                        <TextBox x:Name="TxtParamValue" Text="Quarantine" Padding="6,3" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#334155"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Description -->
                        <TextBlock Text="Rule Description:" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtDescription" Height="50" TextWrapping="Wrap" AcceptsReturn="True"
                                 Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#334155" Padding="6,4" Margin="0,0,0,10"/>

                        <!-- Expected Outcome -->
                        <TextBlock Text="Expected Outcome / Compliance Criteria:" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtExpectedOutcome" Padding="6,4" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#334155" Margin="0,0,0,10"/>

                        <!-- Limitations -->
                        <TextBlock Text="Assessment Method Limitations (Non-Certification Notice):" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtLimitations" Height="40" TextWrapping="Wrap" AcceptsReturn="True"
                                 Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#334155" Padding="6,4" Margin="0,0,0,10"/>

                        <!-- Source Document Citation & URL -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Source Document Citation:" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtSourceDocument" Text="Regulation (EU) No 1321/2014 Annex II" Padding="6,4" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#334155"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Official Source URL:" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtSourceUrl" Text="https://www.easa.europa.eu" Padding="6,4" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#334155"/>
                            </StackPanel>
                        </Grid>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <Button Content="Save / Apply Rule Changes" Click="BtnSaveRule_Click"
                                    Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold"
                                    Padding="16,8" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand"/>
                            <Button Content="Save &amp; Re-Evaluate Model" Click="BtnSaveAndEvaluate_Click"
                                    Background="#059669" Foreground="#FFFFFF" FontWeight="Bold"
                                    Padding="16,8" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="#020617" Padding="20,10" BorderBrush="#1E293B" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Controlled Rule Library: Modifying rules recomputes model findings and traceability registers." 
                           Foreground="#64748B" FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <Button Content="Close" Click="BtnClose_Click"
                        Background="#475569" Foreground="#FFFFFF" FontWeight="SemiBold"
                        Padding="18,6" BorderThickness="0" DockPanel.Dock="Right" Cursor="Hand"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
