<Window x:Class="EasaCompliance.UI.Views.RegulationsStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="EASA Part-145 Regulations Compliance Matrix — Revit 2027"
        Height="780" Width="1240" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Ribbon -->
        <Border Grid.Row="0" Background="#020617" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Vertical">
                <!-- Developer Ribbon -->
                <Border Background="#090D16" Padding="20,6" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="Developer: " Foreground="#94A3B8" FontSize="11" FontWeight="Medium"/>
                            <TextBlock Text="Developer Eng. Sherif Ahmad Magdaldin" Foreground="#F59E0B" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="Autodesk Revit 2027 | EASA Part-145 Facility Regulatory Matrix" DockPanel.Dock="Right" Foreground="#64748B" FontSize="11"/>
                    </DockPanel>
                </Border>

                <!-- Title & Metric Chips -->
                <Border Padding="20,12">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                            <TextBlock Text="EASA PART-145 REGULATORY COMPLIANCE MATRIX" 
                                       Foreground="#FFFFFF" FontSize="17" FontWeight="Bold"/>
                            <TextBlock Text="Consolidated Implementing Rules, AMC, and GM Clause Assessment Register" 
                                       Foreground="#94A3B8" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Live Counter Badges -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Border Background="#1E293B" Padding="10,5" CornerRadius="4" Margin="0,0,6,0">
                                <TextBlock x:Name="TxtTotalRegs" Text="Clauses: 0" Foreground="#F8FAFC" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="#064E3B" Padding="10,5" CornerRadius="4" Margin="0,0,6,0">
                                <TextBlock x:Name="TxtCompliantCount" Text="Meets Modeled: 0" Foreground="#6EE7B7" FontSize="11" FontWeight="Bold"/>
                            </Border>
                            <Border Background="#7F1D1D" Padding="10,5" CornerRadius="4" Margin="0,0,6,0">
                                <TextBlock x:Name="TxtGapsCount" Text="Gaps Found: 0" Foreground="#FCA5A5" FontSize="11" FontWeight="Bold"/>
                            </Border>
                            <Border Background="#78350F" Padding="10,5" CornerRadius="4" Margin="0,0,6,0">
                                <TextBlock x:Name="TxtReviewCount" Text="Needs Review: 0" Foreground="#FDE68A" FontSize="11" FontWeight="Bold"/>
                            </Border>
                            <Border Background="#334155" Padding="10,5" CornerRadius="4">
                                <TextBlock x:Name="TxtDocCount" Text="Documentary Req'd: 0" Foreground="#CBD5E1" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Filters & Search Toolbar -->
        <Border Grid.Row="1" Background="#090D16" Padding="20,10" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="Search Clause / Text:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                    <TextBox x:Name="TxtSearchBox" Width="220" Padding="6,4" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#334155"
                             TextChanged="TxtSearchBox_TextChanged" Margin="0,0,16,0" VerticalAlignment="Center"/>

                    <TextBlock Text="Compliance Filter:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                    <ComboBox x:Name="CmbStatusFilter" Width="180" SelectionChanged="CmbStatusFilter_SelectionChanged"
                              Background="#1E293B" Foreground="#000000" VerticalAlignment="Center" Padding="4">
                        <ComboBoxItem Content="ALL"/>
                        <ComboBoxItem Content="MeetsModeledCheck (Compliant)"/>
                        <ComboBoxItem Content="GapFound (Non-Compliant)"/>
                        <ComboBoxItem Content="NeedsHumanReview"/>
                        <ComboBoxItem Content="NotAssessed (Documentary)"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Re-Evaluate Matrix" Click="BtnReevaluate_Click"
                            Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold"
                            Padding="12,6" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="Export Regulations CSV" Click="BtnExportCsv_Click"
                            Background="#059669" Foreground="#FFFFFF" FontWeight="SemiBold"
                            Padding="12,6" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Master-Detail Split Grid -->
        <Grid Grid.Row="2" Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="620"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Regulations DataGrid -->
            <Border Grid.Column="0" Background="#090D16" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Margin="0,0,12,0">
                <DataGrid x:Name="DgRegulations" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionChanged="DgRegulations_SelectionChanged"
                          Background="Transparent" RowBackground="#090D16" AlternatingRowBackground="#0F172A"
                          Foreground="#E2E8F0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1E293B"
                          HeadersVisibility="Column" RowHeight="36" BorderThickness="0">
                    <DataGrid.Resources>
                        <Style TargetType="{x:Type DataGridColumnHeader}">
                            <Setter Property="Background" Value="#1E293B"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="8,6"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Clause" Binding="{Binding SectionReference}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#38BDF8"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Compliance Status" Binding="{Binding EvaluatedComplianceStatus}" Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Hierarchy" Binding="{Binding Hierarchy}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Right: Regulation Detail Inspector Panel -->
            <Border Grid.Column="1" Background="#090D16" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PnlDetail" Margin="0,0,8,0">
                        <TextBlock Text="REGULATION AUDIT INSPECTOR" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,12"/>

                        <!-- Clause and Status -->
                        <Border Background="#1E293B" Padding="12,10" CornerRadius="4" Margin="0,0,0,14">
                            <DockPanel LastChildFill="False">
                                <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                                    <TextBlock x:Name="TxtDetailClause" Text="145.A.25(d)" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="TxtDetailRegulation" Text="Commission Regulation (EU) No 1321/2014 Annex II" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border x:Name="BadgeDetailStatus" DockPanel.Dock="Right" Padding="10,5" CornerRadius="4" Background="#064E3B" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtDetailStatus" Text="MeetsModeledCheck" FontWeight="Bold" Foreground="#6EE7B7" FontSize="11"/>
                                </Border>
                            </DockPanel>
                        </Border>

                        <!-- Evaluated Status Notes -->
                        <TextBlock Text="Evaluated Compliance State &amp; Notes" FontWeight="SemiBold" Foreground="#94A3B8" FontSize="11"/>
                        <Border Background="#020617" BorderBrush="#1E293B" BorderThickness="1" Padding="10" CornerRadius="4" Margin="0,4,0,12">
                            <TextBlock x:Name="TxtDetailNotes" Text="All modeled elements pass." Foreground="#F8FAFC" FontSize="12" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Summary -->
                        <TextBlock Text="Requirement Summary" FontWeight="SemiBold" Foreground="#94A3B8" FontSize="11"/>
                        <TextBlock x:Name="TxtDetailSummary" Text="Storage facilities for components..." Foreground="#CBD5E1" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,12"/>

                        <!-- Original Rule Extract -->
                        <TextBlock Text="EASA Legal Extract (Implementing Rule / AMC)" FontWeight="SemiBold" Foreground="#94A3B8" FontSize="11"/>
                        <Border Background="#020617" BorderBrush="#1E293B" BorderThickness="1" Padding="10" CornerRadius="4" Margin="0,4,0,12">
                            <TextBlock x:Name="TxtDetailExtract" Text="Original legal wording..." Foreground="#94A3B8" FontStyle="Italic" FontSize="11" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Required Evidence -->
                        <TextBlock Text="Required Verification Evidence (BIM &amp; Documentary)" FontWeight="SemiBold" Foreground="#94A3B8" FontSize="11"/>
                        <Border Background="#020617" BorderBrush="#1E293B" BorderThickness="1" Padding="10" CornerRadius="4" Margin="0,4,0,12">
                            <TextBlock x:Name="TxtDetailEvidence" Text="BIM room boundaries; locked key custody procedure per MOE." Foreground="#FDE68A" FontSize="11" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Associated Model Findings -->
                        <TextBlock Text="Associated Revit Model Findings" FontWeight="SemiBold" Foreground="#94A3B8" FontSize="11"/>
                        <Border Background="#020617" BorderBrush="#1E293B" BorderThickness="1" Padding="10" CornerRadius="4" Margin="0,4,0,14">
                            <TextBlock x:Name="TxtDetailFindings" Text="No associated findings." Foreground="#E2E8F0" FontSize="11" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Official Source URL -->
                        <TextBlock Text="Official EASA Source Documentation" FontWeight="SemiBold" Foreground="#94A3B8" FontSize="11"/>
                        <TextBox x:Name="TxtDetailUrl" Text="https://www.easa.europa.eu" IsReadOnly="True" Background="#1E293B" Foreground="#38BDF8" BorderThickness="0" Padding="6,4" Margin="0,4,0,14" FontSize="10"/>

                        <!-- Reviewer Decision Notes Box -->
                        <TextBlock Text="Qualified Reviewer Sign-Off Notes" FontWeight="SemiBold" Foreground="#94A3B8" FontSize="11"/>
                        <TextBox x:Name="TxtReviewerNotes" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                 Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#334155" Padding="6,4" Margin="0,4,0,10"/>
                        <Button Content="Save Reviewer Notes for Clause" Click="BtnSaveNotes_Click"
                                Background="#334155" Foreground="#FFFFFF" Padding="10,5" BorderThickness="0" HorizontalAlignment="Right" Cursor="Hand"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="3" Background="#020617" Padding="20,10" BorderBrush="#1E293B" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Decision-Support Regulatory Matrix: Qualified auditor confirmation required before final Part-145 approval." 
                           Foreground="#64748B" FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <Button Content="Close" Click="BtnClose_Click"
                        Background="#475569" Foreground="#FFFFFF" FontWeight="SemiBold"
                        Padding="18,6" BorderThickness="0" DockPanel.Dock="Right" Cursor="Hand"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
