<Window x:Class="EasaCompliance.UI.Views.ReportViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="EASA Part-145 Review Report — Compliance Assistance"
        Height="720" Width="1050" MinWidth="850" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Banner -->
        <Border Grid.Row="0" Background="#020617" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Vertical">
                <!-- Developer Top Ribbon -->
                <Border Background="#090D16" Padding="20,6" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="Developer: " Foreground="#94A3B8" FontSize="11" FontWeight="Medium"/>
                            <TextBlock Text="Developer Eng. Sherif Ahmad Magdaldin" Foreground="#F59E0B" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="Autodesk Revit 2027 | EASA Part-145 Lead System Architecture" DockPanel.Dock="Right" Foreground="#64748B" FontSize="11"/>
                    </DockPanel>
                </Border>
                <Border Padding="20,12">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                            <TextBlock Text="EASA PART-145 FACILITY COMPLIANCE-ASSISTANCE REPORT" 
                                       Foreground="#FFFFFF" FontSize="16" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtSubtitle" Text="Annex II to Regulation (EU) No 1321/2014 &amp; Part-IS | Decision Support Package" 
                                       Foreground="#94A3B8" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>

                <!-- Metric Badges -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border Background="#1E293B" Padding="10,4" CornerRadius="4" Margin="0,0,6,0">
                        <TextBlock x:Name="TxtTotalFindings" Text="Findings: 0" Foreground="#F8FAFC" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#7F1D1D" Padding="10,4" CornerRadius="4" Margin="0,0,6,0">
                        <TextBlock x:Name="TxtGapsCount" Text="Gaps: 0" Foreground="#FCA5A5" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <Border Background="#78350F" Padding="10,4" CornerRadius="4" Margin="0,0,6,0">
                        <TextBlock x:Name="TxtReviewCount" Text="Review Req: 0" Foreground="#FDE68A" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <Border Background="#064E3B" Padding="10,4" CornerRadius="4">
                        <TextBlock x:Name="TxtMeetsCount" Text="Meets Modeled: 0" Foreground="#6EE7B7" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</Border>

        <!-- Regulatory Notice Banner -->
        <Border Grid.Row="1" Background="#FEF3C7" Padding="16,8" BorderBrush="#F59E0B" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <TextBlock Text="⚠️ REGULATORY NOTICE:" FontWeight="Bold" Foreground="#92400E" FontSize="11" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                <TextBlock Text="This report is a software-assisted compliance aid for human airworthiness reviewers. It does NOT constitute an EASA certificate, approval, or guarantee of regulatory compliance." 
                           Foreground="#78350F" FontSize="11" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- Monospace Report Viewer -->
        <Border Grid.Row="2" Background="#090D16" Margin="16,12" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4">
            <TextBox x:Name="TxtReportContent" 
                     FontFamily="Consolas, Courier New, monospace" 
                     FontSize="12" 
                     Foreground="#E2E8F0" 
                     Background="Transparent" 
                     BorderThickness="0" 
                     IsReadOnly="True"
                     AcceptsReturn="True" 
                     TextWrapping="NoWrap" 
                     HorizontalScrollBarVisibility="Auto" 
                     VerticalScrollBarVisibility="Auto" 
                     Padding="14"/>
        </Border>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="3" Background="#020617" Padding="16,12" BorderBrush="#1E293B" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="TxtStatusMessage" Text="Report generated successfully." 
                           Foreground="#4ADE80" FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Left"/>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Copy to Clipboard" Click="BtnCopyClipboard_Click"
                            Background="#334155" Foreground="#FFFFFF" FontWeight="SemiBold"
                            Padding="14,7" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="Save to Desktop" Click="BtnSaveDesktop_Click"
                            Background="#1E3A8A" Foreground="#FFFFFF" FontWeight="SemiBold"
                            Padding="14,7" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="Save Text Report (.txt)..." Click="BtnSaveText_Click"
                            Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold"
                            Padding="14,7" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="Save CSV Register (.csv)..." Click="BtnSaveCsv_Click"
                            Background="#059669" Foreground="#FFFFFF" FontWeight="SemiBold"
                            Padding="14,7" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="Save Regulations CSV..." Click="BtnSaveRegsCsv_Click"
                            Background="#0D9488" Foreground="#FFFFFF" FontWeight="SemiBold"
                            Padding="14,7" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="Close" Click="BtnClose_Click"
                            Background="#475569" Foreground="#FFFFFF" FontWeight="SemiBold"
                            Padding="14,7" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
